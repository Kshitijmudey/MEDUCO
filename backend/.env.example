# MEDUCO Healthcare Platform - Environment Configuration
# Copy this file to .env and update the values according to your setup

# =============================================================================
# SERVER CONFIGURATION
# =============================================================================
NODE_ENV=development
PORT=3001
API_PREFIX=/api/v1

# =============================================================================
# DATABASE CONFIGURATION
# =============================================================================
# Database type: 'sqlite' or 'postgresql'
DATABASE_TYPE=postgresql

# SQLite Configuration (if using SQLite)
SQLITE_DB_PATH=./database/meduco.db

# PostgreSQL Configuration (if using PostgreSQL)
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=meduco
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_postgres_password
POSTGRES_MAX_CONNECTIONS=20
POSTGRES_IDLE_TIMEOUT=30000
POSTGRES_CONNECTION_TIMEOUT=2000
POSTGRES_SSL=false

# =============================================================================
# JWT AUTHENTICATION
# =============================================================================
JWT_SECRET=your_super_secret_jwt_key_here_make_it_long_and_complex
JWT_EXPIRES_IN=7d
BCRYPT_ROUNDS=12

# =============================================================================
# RATE LIMITING
# =============================================================================
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# =============================================================================
# EMAIL CONFIGURATION (SMTP)
# =============================================================================
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
SMTP_FROM=MEDUCO Health System <noreply@meduco.com>

# =============================================================================
# SMS CONFIGURATION (Twilio)
# =============================================================================
TWILIO_ACCOUNT_SID=your_twilio_account_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_PHONE_NUMBER=+1234567890

# =============================================================================
# AI CONFIGURATION (OpenAI)
# =============================================================================
OPENAI_API_KEY=your_openai_api_key_here

# =============================================================================
# FILE UPLOAD CONFIGURATION
# =============================================================================
UPLOAD_MAX_SIZE=10485760
UPLOAD_ALLOWED_TYPES=image/jpeg,image/png,application/pdf,text/plain

# =============================================================================
# SECURITY CONFIGURATION
# =============================================================================
CORS_ORIGIN=http://localhost:8080
CORS_CREDENTIALS=true

# =============================================================================
# LOGGING CONFIGURATION
# =============================================================================
LOG_LEVEL=info
LOG_FILE=./logs/meduco.log

# =============================================================================
# DEVELOPMENT CONFIGURATION
# =============================================================================
# Set to true for development mode features
DEBUG_MODE=false
VERBOSE_LOGGING=false

# =============================================================================
# PRODUCTION CONFIGURATION
# =============================================================================
# SSL Configuration for production
SSL_CERT_PATH=
SSL_KEY_PATH=

# Session configuration
SESSION_SECRET=your_session_secret_here

# =============================================================================
# MIGRATION CONFIGURATION
# =============================================================================
# Set to true to run migrations on startup
AUTO_MIGRATE=false
BACKUP_BEFORE_MIGRATE=true

# =============================================================================
# HEALTHCARE SPECIFIC CONFIGURATION
# =============================================================================
# Default appointment duration in minutes
DEFAULT_APPOINTMENT_DURATION=30

# Reminder settings
MEDICATION_REMINDER_TIME=08:00
APPOINTMENT_REMINDER_HOURS=24

# Care plan settings
DEFAULT_CARE_PLAN_DURATION_DAYS=90

# =============================================================================
# EXTERNAL SERVICES
# =============================================================================
# Third-party integrations (if any)
STRIPE_SECRET_KEY=
STRIPE_PUBLIC_KEY=

# Google Calendar API (for appointment sync)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Firebase (for push notifications)
FIREBASE_SERVER_KEY=

# =============================================================================
# MONITORING & ANALYTICS
# =============================================================================
# Application monitoring
SENTRY_DSN=

# Analytics
GOOGLE_ANALYTICS_ID=

# Performance monitoring
NEW_RELIC_LICENSE_KEY=
